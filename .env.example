# ── Server ────────────────────────────────────────────────────────────────────

# Port the Express server listens on (default: 3001)
PORT=3001

# Origin of the Vite dev server (default: http://localhost:5173)
CLIENT_ORIGIN=http://localhost:5173

# Controls the database (Supabase) only. "true" saves accounts, events, tasks
# and resources to JSON files in server/data/ (they survive restarts);
# set to "false" once Supabase is configured.
# Gemini and Backboard switch to real calls as soon as their key is set below.
USE_MOCK=true

# Secret used to sign login tokens. REQUIRED in production — use a long random
# string, e.g. the output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Where accounts and org data are saved while USE_MOCK=true
# (default: server/data/users.json and server/data/store.json)

# ── Supabase ──────────────────────────────────────────────────────────────────
# Required when USE_MOCK=false
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Optional. Leave empty to run Gemini through Backboard (needs BACKBOARD_API_KEY),
# or set a key from https://aistudio.google.com/apikey to call Gemini directly.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# ── Backboard ─────────────────────────────────────────────────────────────────
# Leave empty to use mock answers. Get a key at https://app.backboard.io
BACKBOARD_API_KEY=
# Name of the Backboard assistant that holds this org's documents and memories.
# It is created automatically on first use.
# BACKBOARD_ASSISTANT_NAME=OrgFlow
# Or point at an existing assistant directly:
# BACKBOARD_ASSISTANT_ID=
# Which model Backboard uses to read the documents:
# BACKBOARD_LLM_PROVIDER=google
# BACKBOARD_MODEL_NAME=gemini-2.5-flash-lite   (fast; gemini-3.8-flash is ~10x slower)
# "off" (default): answers use documents + each club's own wrap-ups. "Readonly" also reads
# Backboard memory (shared by all clubs). Avoid "Auto": it saves every question as a "fact".
# BACKBOARD_MEMORY_MODE=off
